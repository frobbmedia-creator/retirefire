# Stripe (RetireFire Pro)
# Keep false until purchases are persisted and paid features are delivered.
STRIPE_CHECKOUT_ENABLED=false
ENTITLEMENT_SIGNING_SECRET=replace_with_a_long_random_value
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...
